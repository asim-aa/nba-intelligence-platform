# Settings for the dashboard's LLM agent (see README, "Ask the dashboard").
# The app does NOT load this file: export these in your shell, or set them
# as secrets on your host. Without the first two the chat panel is disabled
# and the rest of the dashboard works as normal.
OPENAI_API_KEY=
NBA_AGENT_MODEL=
# Only for a non-OpenAI, OpenAI-compatible endpoint:
# OPENAI_BASE_URL=
